# Copie este ficheiro para ".env" e preencha com os dados do seu projecto Supabase.
# Encontre esses valores em: Supabase > Project Settings > API

# Chave pública — segura para o browser (usada no cliente React)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui

# Chave de serviço — NUNCA exposta ao browser.
# Usada apenas pelas funções serverless em /api/ (Vercel Functions).
# Adicionar nas variáveis de ambiente do Vercel: Settings > Environment Variables
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
